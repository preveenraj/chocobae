# Google Places API (New) — https://developers.google.com/maps/documentation/places/web-service/overview
# Required to fetch live Google rating. Falls back to 4.9 if unset.
GOOGLE_PLACES_API_KEY=your_api_key_here

# Find your Place ID at: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=your_place_id_here
